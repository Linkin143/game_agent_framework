{
  "_comment": "Per-game subgoal configuration for Netflix. Package: com.netflix.mediaclient",

  "subgoal_order": [
    "APP_LAUNCH",
    "DISMISS_POPUPS",
    "NAVIGATE_TO_MAIN_MENU",
    "SELECT_CONTENT",
    "VERIFY_PLAYBACK"
  ],

  "subgoal_confirmations": {
    "APP_LAUNCH": {
      "require_any": [],
      "exclude_if":  []
    },

    "DISMISS_POPUPS": {
      "require_any": ["HOME", "TRENDING", "BROWSE", "SEARCH", "MY LIST"],
      "exclude_if":  ["ALLOW", "ACCEPT", "SIGN IN", "LOG IN", "CONTINUE WATCHING"]
    },

    "NAVIGATE_TO_MAIN_MENU": {
      "require_any": ["HOME", "TRENDING", "BROWSE", "SEARCH"],
      "exclude_if":  ["PLAY", "RESUME", "EPISODE", "SEASON", "PAUSE"]
    },

    "SELECT_CONTENT": {
      "require_any": ["PLAY", "RESUME", "EPISODE", "SEASON", "WATCH"],
      "exclude_if":  ["HOME", "TRENDING", "BROWSE", "PAUSE", "SKIP INTRO"]
    },

    "VERIFY_PLAYBACK": {
      "require_any": ["PAUSE", "SKIP INTRO", "EPISODES", "AUDIO"],
      "exclude_if":  ["PLAY", "RESUME", "HOME", "TRENDING", "BROWSE", "SIGN IN"]
    }
  }
}
