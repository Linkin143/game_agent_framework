# ============================================================
# game_agent_framework — Environment Configuration
# Copy this to .env and fill in your actual values.
# ============================================================

# ── LLM ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ── Appium ───────────────────────────────────────────────────
APPIUM_SERVER_URL=http://127.0.0.1:4723

# ── Device ───────────────────────────────────────────────────
DEVICE_NAME=emulator-5554
DEVICE_UDID=emulator-5554
PLATFORM_VERSION=13.0

# ── Timing ───────────────────────────────────────────────────
IMPLICIT_WAIT=3
POST_ACTION_WAIT=0.8

# ── Default app package (used when goal doesn't match known apps) ──
DEFAULT_APP_PACKAGE=com.ninjakiwi.bloonstd6

# ── Game HUD coordinate hints (optional, improves Tier 3 accuracy) ──
# GAME_PAUSE_BUTTON_X=980
# GAME_PAUSE_BUTTON_Y=120
